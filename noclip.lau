--// ==================== زر الخروج ====================

local exitButton = Instance.new("TextButton")
exitButton.Name = "ExitButton"
exitButton.Size = UDim2.new(1, -30, 0, 38)
exitButton.Position = UDim2.new(0, 15, 0, 127)
exitButton.BackgroundColor3 = Color3.fromRGB(160, 35, 35)
exitButton.BorderSizePixel = 0
exitButton.Text = "❌ خروج من السكربت"
exitButton.TextColor3 = Color3.fromRGB(255, 255, 255)
exitButton.Font = Enum.Font.GothamBold
exitButton.TextSize = 14
exitButton.AutoButtonColor = false
exitButton.ZIndex = 11
exitButton.Parent = main

local exitCorner = Instance.new("UICorner")
exitCorner.CornerRadius = UDim.new(0, 10)
exitCorner.Parent = exitButton

local exitStroke = Instance.new("UIStroke")
exitStroke.Thickness = 1
exitStroke.Color = Color3.fromRGB(220, 70, 70)
exitStroke.Parent = exitButton

--// ==================== حفظ التصادم ====================

local function saveOriginalCollision(char)
    originalCollision = {}

    if not char then
        return
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            originalCollision[obj] = obj.CanCollide
        end
    end
end

--// ==================== استرجاع التصادم ====================

local function restoreOriginalCollision(char)
    if not char then
        return
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originalCollision[obj] ~= nil then
                obj.CanCollide = originalCollision[obj]
            end
        end
    end

    originalCollision = {}
end

--// ==================== تشغيل NOCLIP ====================

local function enableNoclip()
    noclipEnabled = true

    noclipButton.Text = "🟢 NOCLIP : ON"
    noclipButton.BackgroundColor3 = Color3.fromRGB(45, 150, 70)
    mainStroke.Color = Color3.fromRGB(60, 220, 100)

    local char = player.Character

    if not char then
        return
    end

    saveOriginalCollision(char)

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    noclipConnection = RunService.Stepped:Connect(function()
        if not noclipEnabled then
            return
        end

        local currentCharacter = player.Character

        if not currentCharacter then
            return
        end

        for _, obj in ipairs(currentCharacter:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end)
end

--// ==================== إيقاف NOCLIP ====================

local function disableNoclip()
    noclipEnabled = false

    noclipButton.Text = "🔴 NOCLIP : OFF"
    noclipButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    mainStroke.Color = Color3.fromRGB(220, 60, 60)

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    local char = player.Character

    if char then
        restoreOriginalCollision(char)

        local humanoid = char:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true

            task.defer(function()
                if humanoid and humanoid.Parent then
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
    end
end

--// ==================== تشغيل / إيقاف ====================

local function toggleNoclip()
    if noclipEnabled then
        disableNoclip()
    else
        enableNoclip()
    end
end

noclipButton.MouseButton1Click:Connect(toggleNoclip)
noclipButton.TouchTap:Connect(toggleNoclip)

--// ==================== الدائرة العائمة ====================

local floatingButton = Instance.new("TextButton")
floatingButton.Name = "FloatingButton"
floatingButton.AnchorPoint = Vector2.new(0, 0.5)
floatingButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
floatingButton.BorderSizePixel = 0
floatingButton.Text = "FM"
floatingButton.TextColor3 = Color3.fromRGB(255, 70, 70)
floatingButton.Font = Enum.Font.GothamBold
floatingButton.AutoButtonColor = false
floatingButton.Visible = false
floatingButton.Active = true
floatingButton.ZIndex = 200
floatingButton.Parent = gui

local floatingCorner = Instance.new("UICorner")
floatingCorner.CornerRadius = UDim.new(1, 0)
floatingCorner.Parent = floatingButton

local floatingStroke = Instance.new("UIStroke")
floatingStroke.Thickness = 2
floatingStroke.Color = Color3.fromRGB(220, 60, 60)
floatingStroke.Parent = floatingButton

--// حجم الدائرة حسب الجهاز
local function getFloatingSize()
    local camera = workspace.CurrentCamera

    if not camera then
        return 55
    end

    local viewport = camera.ViewportSize

    if viewport.X <= 480 then
        return 48
    elseif viewport.X <= 800 then
        return 52
    else
        return 58
    end
end

--// وضع الدائرة يسار الشاشة
local function updateFloatingButton()
    local size = getFloatingSize()

    floatingButton.Size = UDim2.new(0, size, 0, size)
    floatingButton.Position = UDim2.new(
        0,
        12,
        0.5,
        0
    )

    floatingButton.TextSize = math.clamp(size * 0.29, 13, 18)
end

updateFloatingButton()

--// تحديثها عند تغيير حجم الشاشة
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    if floatingButton.Visible and not floatingDragging then
        updateFloatingButton()
    end
end)

--// ==================== إخفاء / إظهار ====================

local function hideScript()
    main.Visible = false

    -- كل مرة خروج يرجع الدائرة لليسار
    updateFloatingButton()

    floatingButton.Visible = true
end

local function showScript()
    floatingButton.Visible = false
    main.Visible = true
end

exitButton.MouseButton1Click:Connect(hideScript)
exitButton.TouchTap:Connect(hideScript)

floatingButton.MouseButton1Click:Connect(showScript)
floatingButton.TouchTap:Connect(showScript)

--// ==================== تحريك الدائرة ====================

local floatingDragging = false
local floatingDragStart = nil
local floatingStartPosition = nil

floatingButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        floatingDragging = true
        floatingDragStart = input.Position
        floatingStartPosition = floatingButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not floatingDragging then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local size = floatingButton.AbsoluteSize
    local delta = input.Position - floatingDragStart

    local newX = floatingStartPosition.X.Offset + delta.X
    local newY = floatingStartPosition.Y.Offset + delta.Y

    -- منع خروج الدائرة من الشاشة
    newX = math.clamp(
        newX,
        5,
        math.max(5, viewport.X - size.X - 5)
    )

    local centerY = newY
    local halfHeight = viewport.Y / 2

    centerY = math.clamp(
        centerY,
        -halfHeight + (size.Y / 2) + 5,
        halfHeight - (size.Y / 2) - 5
    )

    floatingButton.Position = UDim2.new(
        0,
        newX,
        0.5,
        centerY
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        floatingDragging = false
    end
end)

--// ==================== أنيميشن الدائرة ====================

local floatingScale = Instance.new("UIScale")
floatingScale.Scale = 1
floatingScale.Parent = floatingButton

task.spawn(function()
    while gui and gui.Parent do
        if floatingButton.Visible then

            local tween1 = TweenService:Create(
                floatingScale,
                TweenInfo.new(
                    0.8,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                ),
                {
                    Scale = 1.08
                }
            )

            tween1:Play()
            tween1.Completed:Wait()

            if floatingButton.Visible then

                local tween2 = TweenService:Create(
                    floatingScale,
                    TweenInfo.new(
                        0.8,
                        Enum.EasingStyle.Sine,
                        Enum.EasingDirection.InOut
                    ),
                    {
                        Scale = 1
                    }
                )

                tween2:Play()
                tween2.Completed:Wait()
            end

        else
            task.wait(0.2)
        end
    end
end)

--// ==================== RESPAWN ====================

player.CharacterAdded:Connect(function(newCharacter)

    character = newCharacter
    originalCollision = {}

    if noclipEnabled then

        task.wait(0.2)

        saveOriginalCollision(newCharacter)

        for _, obj in ipairs(newCharacter:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end

    end
end)

--// ==================== سحب الواجهة الرئيسية ====================

local dragging = false
local dragStart = nil
local startPosition = nil

main.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position

    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not dragging then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - dragStart

    main.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false

    end
end)

--// ==================== Hover Effects ====================

noclipButton.MouseEnter:Connect(function()
    if not noclipEnabled then
        noclipButton.BackgroundColor3 = Color3.fromRGB(70, 70, 82)
    end
end)

noclipButton.MouseLeave:Connect(function()
    if not noclipEnabled then
        noclipButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    end
end)

exitButton.MouseEnter:Connect(function()
    exitButton.BackgroundColor3 = Color3.fromRGB(190, 45, 45)
end)

exitButton.MouseLeave:Connect(function()
    exitButton.BackgroundColor3 = Color3.fromRGB(160, 35, 35)
end)

floatingButton.MouseEnter:Connect(function()
    floatingStroke.Color = Color3.fromRGB(255, 100, 100)
end)

floatingButton.MouseLeave:Connect(function()
    floatingStroke.Color = Color3.fromRGB(220, 60, 60)
end)
