--// ==================== زر NOCLIP ====================

local noclipButton = Instance.new("TextButton")
noclipButton.Name = "NoclipButton"
noclipButton.Size = UDim2.new(1, -30, 0, 45)
noclipButton.Position = UDim2.new(0, 15, 0, 72)
noclipButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
noclipButton.BorderSizePixel = 0
noclipButton.Text = "🔴 NOCLIP : OFF"
noclipButton.TextColor3 = Color3.fromRGB(255, 255, 255)
noclipButton.Font = Enum.Font.GothamBold
noclipButton.TextSize = 15
noclipButton.AutoButtonColor = false
noclipButton.ZIndex = 11
noclipButton.Parent = main

local noclipCorner = Instance.new("UICorner")
noclipCorner.CornerRadius = UDim.new(0, 10)
