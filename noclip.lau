--// 🏙️ BROOKHAVEN - FAHAD UTILITIES (CYBERPUNK STYLE)
if _G.BrookhavenForceStandLoaded then 
    print("⚠️ السكريبت شغال مسبقاً")
    return 
end
_G.BrookhavenForceStandLoaded = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

--// ==================== VARIABLES ====================
local FORCE_STAND = false
local noclipEnabled = false
local noclipConnection = nil
local originalCollision = {}

--// ==================== NOCLIP LOGIC ====================
local function saveOriginalCollision(char)
    originalCollision = {}
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            originalCollision[obj] = obj.CanCollide
        end
    end
end

local function restoreOriginalCollision(char)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originalCollision[obj] ~= nil then
                obj.CanCollide = originalCollision[obj]
            end
        end
    end
    originalCollision = {}
end

local function disableNoclip()
    noclipEnabled = false
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    local char = player.Character
    if char then
        restoreOriginalCollision(char)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
            task.defer(function()
                if humanoid and humanoid.Parent then
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
    end
end

local function enableNoclip()
    noclipEnabled = true
    local char = player.Character
    if not char then return end

    saveOriginalCollision(char)
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    noclipConnection = RunService.Stepped:Connect(function()
        if not noclipEnabled then return end
        local currentCharacter = player.Character
        if not currentCharacter then return end
        for _, obj in ipairs(currentCharacter:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end)
end

--// ==================== FORCE STAND LOGIC ====================
local function applyProtection(character)
    if not character then return end
    local hum = character:WaitForChild("Humanoid", 5)
    if not hum then return end

    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, not FORCE_STAND)

    hum:GetPropertyChangedSignal("Sit"):Connect(function()
        if FORCE_STAND and hum.Sit then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

if player.Character then applyProtection(player.Character) end
player.CharacterAdded:Connect(function(char)
    applyProtection(char)
    if noclipEnabled then
        task.wait(0.2)
        saveOriginalCollision(char)
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    local char = player.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and FORCE_STAND and hum.Sit then
        hum.Sit = false
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
end)

